<!DOCTYPE html>
<html>
  <head>
    <title>PageFeedback</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "page_feedback/page_feedback", "data-turbo-track": "reload" %>
  </head>
  <body class="page-feedback-review-body">
    <header class="page-feedback-review-header">
      <% if (host_root_path = page_feedback_host_root_path) %>
        <%= link_to "← Back to site", host_root_path, class: "page-feedback-review-home" %>
      <% end %>
      <%= link_to "PageFeedback", review_pages_path %>
      <span>Review</span>
      <%= link_to "Exports", review_exports_path %>
    </header>
    <main class="page-feedback-review-main">
      <%= yield %>
    </main>
  </body>
</html>
