<section class="page-feedback-detail">
  <header>
    <p class="page-feedback-review-eyebrow">Immutable history</p>
    <h1>Exports</h1>
    <%= link_to "Create export", new_review_export_path, class: "page-feedback-review-link" %>
  </header>
  <% if @exports.any? %>
    <div class="page-feedback-page-list">
      <% @exports.each do |export| %>
        <article class="page-feedback-page-row">
          <div class="page-feedback-page-row__identity">
            <h2><%= export.label.presence || "Export ##{export.id}" %></h2>
            <% if export.label.present? %><p>Export #<%= export.id %></p><% end %>
            <time datetime="<%= export.created_at.iso8601 %>"><%= export.created_at.to_fs(:long) %></time>
          </div>
          <p><%= pluralize(export.export_items.length, "revision") %></p>
          <code><%= export.body_digest.first(12) %></code>
          <%= link_to "Open export", review_export_path(export), class: "page-feedback-review-link" %>
        </article>
      <% end %>
    </div>
    <% if @pager.paged? %>
      <nav class="page-feedback-pager" aria-label="Export pages">
        <% if @pager.newer_page %><%= link_to "Newer", review_exports_path(page: @pager.newer_page), rel: "prev", class: "page-feedback-review-link" %><% end %>
        <span>Page <%= @pager.page %> of <%= @pager.pages %></span>
        <% if @pager.older_page %><%= link_to "Older", review_exports_path(page: @pager.older_page), rel: "next", class: "page-feedback-review-link" %><% end %>
      </nav>
    <% end %>
  <% else %>
    <div class="page-feedback-review-empty"><h2>No exports yet</h2></div>
  <% end %>
</section>
