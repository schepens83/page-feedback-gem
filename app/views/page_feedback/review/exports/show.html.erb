<article class="page-feedback-detail">
  <header>
    <%= link_to "← Export history", review_exports_path %>
    <p class="page-feedback-review-eyebrow">Immutable Markdown</p>
    <h1><%= @export.label.presence || "Export ##{@export.id}" %></h1>
    <% if @export.label.present? %><p>Export #<%= @export.id %></p><% end %>
    <p>
      <%= pluralize(@export.export_items.length, "revision") %> ·
      <%= @export.format.titleize %> ·
      <%= @export.created_at.to_fs(:long) %>
      <% if @export.created_by.present? %>
        · Created by <%= page_feedback_actor_label(@export.created_by) %>
      <% end %>
    </p>
  </header>
  <div class="page-feedback-review-actions"
       data-controller="page-feedback-copy"
       data-page-feedback-copy-text-value="<%= @export.body %>">
    <button type="button" class="page-feedback-review-action page-feedback-review-action--approve"
            data-action="page-feedback-copy#copy">Copy Markdown</button>
    <%= link_to "Download Markdown", review_export_path(@export, format: :md), class: "page-feedback-review-action" %>
    <span data-page-feedback-copy-target="status" role="status"></span>
  </div>
  <details class="page-feedback-detail__section page-feedback-handoff-codes">
    <summary>Send to phone</summary>
    <% if @handoff.fits? %>
      <% parts = @handoff.parts %>
      <p>
        Scan <%= parts.length == 1 ? "the code" : "each code, in any order," %> with your phone's camera.
        The page that opens unpacks the Markdown there; the export travels inside the link, not over the network.
      </p>
      <ol class="page-feedback-handoff-codes__list">
        <% parts.each do |part| %>
          <li>
            <img src="data:image/svg+xml;base64,<%= Base64.strict_encode64(part.svg) %>"
                 alt="QR code <%= part.index %> of <%= part.total %>">
            <span><%= part.index %> / <%= part.total %></span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p>This export is too large for QR codes. Download the Markdown instead.</p>
    <% end %>
  </details>
  <pre class="page-feedback-export-body"><%= @export.body %></pre>
  <section class="page-feedback-detail__section">
    <h2>Included revisions</h2>
    <ol>
      <% @export.export_items.each do |item| %>
        <li><%= link_to item.comment.effective_text, review_comment_path(item.comment) %></li>
      <% end %>
    </ol>
  </section>
</article>
