<article class="page-feedback-detail page-feedback-handoff" data-controller="page-feedback-handoff">
  <header>
    <p class="page-feedback-review-eyebrow">Forwarded feedback</p>
    <h1>Import from another installation</h1>
    <p data-page-feedback-handoff-target="status" role="status">
      Open a forward link from another installation of this app to import its feedback here.
    </p>
  </header>
  <%= form_with url: review_imports_path,
                class: "page-feedback-handoff__form",
                data: { page_feedback_handoff_target: "form", action: "page-feedback-handoff#submit", turbo: false },
                html: { hidden: true } do |form| %>
    <%= form.hidden_field :payload, data: { page_feedback_handoff_target: "payload" } %>
    <ol class="page-feedback-handoff__list" data-page-feedback-handoff-target="list"></ol>
    <div class="page-feedback-review-actions">
      <%= form.submit "Import",
                      class: "page-feedback-review-action page-feedback-review-action--approve",
                      data: { page_feedback_handoff_target: "submit" } %>
    </div>
  <% end %>
</article>
