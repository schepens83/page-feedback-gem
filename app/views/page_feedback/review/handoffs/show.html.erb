<article class="page-feedback-detail page-feedback-handoff" data-controller="page-feedback-handoff">
  <header>
    <p class="page-feedback-review-eyebrow">Export from another device</p>
    <h1>Unpack export</h1>
    <p data-page-feedback-handoff-target="status" role="status">
      Scan an export's QR code with this phone's camera to open it here.
    </p>
  </header>
  <div class="page-feedback-review-actions" data-page-feedback-handoff-target="actions" hidden>
    <button type="button" class="page-feedback-review-action page-feedback-review-action--approve"
            data-action="page-feedback-handoff#copy">Copy Markdown</button>
    <span data-page-feedback-handoff-target="copyStatus" role="status"></span>
  </div>
  <pre class="page-feedback-export-body" data-page-feedback-handoff-target="body" hidden></pre>
</article>
