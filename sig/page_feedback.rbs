module PageFeedback
  VERSION: String

  interface _ControllerCallback
    def call: (untyped controller) -> untyped
  end

  interface _Authorizer
    def call: (untyped controller) -> bool
  end

  interface _ActorLabel
    def call: (untyped actor) -> String
  end

  interface _SourceLocator
    def call: (untyped comment) -> String?
  end

  interface _ExportFormatter
    def call: (comments: untyped, generated_at: untyped) -> String
  end

  class Configuration
    DEFAULT_CATEGORIES: Hash[String, String]
    DEFAULT_CURRENT_ACTOR: _ControllerCallback
    DEFAULT_AUTHORIZER: _Authorizer
    DEFAULT_ACTOR_LABEL: _ActorLabel
    DEFAULT_SOURCE_LOCATOR: _SourceLocator

    attr_accessor current_actor: _ControllerCallback
    attr_accessor capture_authorizer: _Authorizer
    attr_accessor review_authorizer: _Authorizer
    attr_accessor actor_label: _ActorLabel
    attr_accessor categories: Hash[String, String]
    attr_accessor default_category: String
    attr_accessor activation_shortcut: Hash[Symbol, bool | String]
    attr_accessor ignored_css_classes: Array[String]
    attr_accessor source_locator: _SourceLocator
    attr_accessor export_formatter: _ExportFormatter

    def initialize: () -> void
  end

  class Diagnostics
    class Check
      attr_accessor name: String
      attr_accessor label: String
      attr_accessor status: String
      attr_accessor details: String

      def to_h: () -> Hash[String, String]
    end

    class Report
      attr_accessor version: String
      attr_accessor rails_version: String
      attr_accessor checks: Array[Check]
      attr_accessor review_path: String
      attr_accessor docs_path: String

      def ok?: () -> bool
      def to_h: () -> Hash[String, untyped]
      def to_json: (*untyped) -> String
      def to_text: () -> String
    end

    def initialize: (?application: untyped, ?root: untyped, ?configuration: Configuration, **untyped) -> void
    def call: () -> Report
  end

  class Command
    HELP: String

    def self.run: (Array[String] arguments, **untyped) -> Integer
    def initialize: (Array[String] arguments, **untyped) -> void
    def run: () -> Integer
  end

  def self.configuration: () -> Configuration
  def self.configure: () { (Configuration) -> untyped } -> Configuration
  def self.reset_configuration!: () -> Configuration

  module Exporters
    class Markdown
      def self.call: (comments: untyped, generated_at: untyped) -> String
    end
  end
end
